# ==================================================
# Cau hinh API keys — copy file nay thanh .env va dien key that
# Lenh (PowerShell):  copy .env.example .env
# KHONG BAO GIO commit file .env vao Git (da co trong .gitignore)
# ==================================================

# --- LLM chinh: OpenRouter (nhieu model mien phi, khong bi gioi han 20 req/ngay) ---
# Tao key mien phi tai: https://openrouter.ai/keys
# Model mien phi co suffix :free (vd: openai/gpt-oss-20b:free)
# Xem danh sach model mien phi: https://openrouter.ai/models?max_price=0
# Ung dung TU DONG lay danh sach model :free moi nhat tu API OpenRouter
# (khong can khai bao gi them). Chi khi muon tu dinh nghia danh sach rieng
# thi bo comment dong duoi (cach nhau boi dau phay):
# OPENROUTER_MODELS=openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- LLM du phong: Google Gemini (free tier, chi dung khi OpenRouter loi) ---
# Tao key mien phi tai: https://aistudio.google.com/apikey
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# --- Embedding model (chay local, khong can key) ---
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder

# --- Duong dan ---
DATA_RAW_DIR=data/raw
VECTORSTORE_DIR=vectorstore

# --- Retrieval ---
RETRIEVER_TOP_K=5
